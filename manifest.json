{
  "specVersion": 2,
  "minAppVersion": "0.93.0",
  "id": "dev.yxu9949-design.fourthwall-room",
  "name": {
    "$t": "plugin.name"
  },
  "version": "1.2.0",
  "author": "yxu9949-design",
  "description": {
    "$t": "plugin.description"
  },
  "permissions": [
    "chat",
    "character",
    "message",
    "memory",
    "vector",
    "generate",
    "file"
  ],
  "contributes": {
    "visible": {
      "chat": true
    },
    "htmlFragments": [
      {
        "id": "fourthwall-chat",
        "src": "ui/panel.html",
        "mount": "/chat/body/end"
      }
    ]
  },
  "releaseNotes": {
    "$t": "releaseNotes.1_2_0"
  },
  "localization": {
    "defaultLocale": "zh-CN",
    "resources": {
      "zh-CN": "locales/zh-CN.json",
      "en": "locales/en.json"
    }
  }
}
